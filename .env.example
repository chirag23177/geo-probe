# Copy this file to .env and fill in your keys:
#
#   cp .env.example .env
#
# The CLI reads .env from the directory you run it in. An already-exported
# environment variable takes precedence over the value here, so a stale file
# can never silently override a key you just set in your shell.
#
# .env is gitignored. Do not commit it.

ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
